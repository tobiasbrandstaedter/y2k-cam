{
  "name": "y2k",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Private retro camera editor. iOS Safari 17+ PWA.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "spikes": "vite --config spikes/vite.config.ts",
    "spikes:http": "vite --config spikes/vite.config.ts --mode http"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
